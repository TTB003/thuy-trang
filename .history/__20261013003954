'use strict';

/* Kiểm thử trực tiếp tầng dịch vụ: nâng cấp lược đồ, phiếu sinh nhật,
   thông báo và đánh dấu đã đọc. Dữ liệu thử được dọn sạch sau khi xong. */

const db = require('../src/db');
const migrations = require('../src/db/migrations');
const voucherService = require('../src/services/voucher.service');
const thongbaoService = require('../src/services/thongbao.service');
const uuDaiService = require('../src/services/uu-dai-sinh-nhat.service');
const { toSqlDate } = require('../src/core/time');

const MA_KH = 2;

async function main() {
  await db.init();
  console.log(`Hệ CSDL: ${db.getClient()}`);

  const nangCap = await migrations.chayNangCapLuocDo();
  console.log(`Nâng cấp lược đồ: ${JSON.stringify(nangCap)}`);

  const bang = await db.danhSachBang();
  const coBang = bang.filter((ten) => ['PHIEUGIAMGIA', 'THONGBAO'].includes(String(ten).toUpperCase()));
  console.log(`Bảng mới hiện có: ${JSON.stringify(coBang)}`);

  const khach = await db.get('SELECT maKH, hoTen, ngaySinh FROM KHACHHANG WHERE maKH = :maKH', {
    maKH: MA_KH,
  });
  console.log(`Khách thử: #${khach.maKH} ${khach.hoTen} — ngày sinh gốc: ${khach.ngaySinh}`);
  const ngaySinhGoc = khach.ngaySinh;

  // Tạm đặt sinh nhật đúng hôm nay để chạy bộ quét.
  const homNay = toSqlDate().slice(5);
  await db.run('UPDATE KHACHHANG SET ngaySinh = :ngaySinh WHERE maKH = :maKH', {
    ngaySinh: `1995-${homNay}`,
    maKH: MA_KH,
  });

  const danhSach = await uuDaiService.danhSachKhachSinhNhatHomNay();
  console.log(`\nKhách có sinh nhật hôm nay (${homNay}): ${JSON.stringify(danhSach.map((k) => k.hoTen))}`);

  const ketQuaQuet = await uuDaiService.chayUuDaiSinhNhat();
  console.log(`Lượt quét: ${JSON.stringify(ketQuaQuet)}`);

  const uuDai = await voucherService.listPhieuGiamGia(MA_KH, { pageSize: 5 });
  console.log(`\nPhiếu giảm giá của khách #${MA_KH}: ${uuDai.pagination.total}`);
  console.log(`  ${JSON.stringify(uuDai.items[0] ?? null)}`);

  const thongKe = await voucherService.thongKePhieuCuaKhach(MA_KH);
  console.log(`  Thống kê: ${JSON.stringify(thongKe)}`);

  const tomTat = await thongbaoService.tomTatThongBao(MA_KH);
  console.log(`\nChuông thông báo: chưa đọc = ${tomTat.chuaDoc}`);
  console.log(`  ${JSON.stringify(tomTat.moiNhat[0] ?? null)}`);

  const danhSachTb = await thongbaoService.listThongBao(MA_KH, { pageSize: 3 });
  console.log(`  Tổng thông báo: ${danhSachTb.pagination.total}`);

  if (tomTat.moiNhat[0]) {
    const daDoc = await thongbaoService.danhDauDaDoc(MA_KH, tomTat.moiNhat[0].maTB);
    console.log(`  Đánh dấu đã đọc: ${JSON.stringify(daDoc)}`);
  }

  const tatCa = await thongbaoService.danhDauTatCaDaDoc(MA_KH);
  console.log(`  Đánh dấu tất cả đã đọc: ${JSON.stringify(tatCa)}`);

  // Quét lần hai: phải KHÔNG tạo thêm phiếu cho cùng năm.
  const quetLai = await uuDaiService.chayUuDaiSinhNhat();
  console.log(`\nQuét lần 2 (phải bằng 0): soPhieuDaTang = ${quetLai.soPhieuDaTang}`);

  /* ---------------------- DỌN DẸP DỮ LIỆU THỬ ---------------------- */
  const nam = new Date().getFullYear();
  const maCode = voucherService.maPhieuSinhNhat(MA_KH, nam);
  await db.run('DELETE FROM THONGBAO WHERE maKH = :maKH AND maPG IN (SELECT maPG FROM PHIEUGIAMGIA WHERE maCode = :maCode)', { maKH: MA_KH, maCode });
  await db.run('DELETE FROM PHIEUGIAMGIA WHERE maKH = :maKH AND maCode = :maCode', { maKH: MA_KH, maCode });
  await db.run('UPDATE KHACHHANG SET ngaySinh = :ngaySinh WHERE maKH = :maKH', {
    ngaySinh: ngaySinhGoc,
    maKH: MA_KH,
  });

  const conLai = await db.scalar('SELECT COUNT(*) FROM PHIEUGIAMGIA WHERE maKH = :maKH', { maKH: MA_KH });
  const tbConLai = await db.scalar('SELECT COUNT(*) FROM THONGBAO WHERE maKH = :maKH', { maKH: MA_KH });
  const khachSau = await db.get('SELECT ngaySinh FROM KHACHHANG WHERE maKH = :maKH', { maKH: MA_KH });
  console.log(`\nDọn dẹp: phiếu còn ${conLai}, thông báo còn ${tbConLai}, ngày sinh khôi phục = ${khachSau.ngaySinh}`);

  await db.closeDb();
}

main().catch((loi) => {
  console.error('LỖI:', loi);
  process.exitCode = 1;
});
